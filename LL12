         self.next = next
class Solution(object):
    def reverseBetween(self, head, left, right):
        if head == None or head.next == None or left == right:
            return head
        dummy = ListNode(0)
        dummy.next = head
        cur = head
        leftprev = dummy
        for i in range(left-1):
            cur = cur.next
            leftprev= leftprev.next
        prev = None
        for i in range(right-left+1):
            nxt = cur.next
            cur.next = prev
            prev = cur
            cur = nxt
            
        leftprev.next.next = cur
        leftprev.next = prev
        return dummy.next

        
        
        
            
        
