class Solution(object):
    def isPalindrome(self, head):
        slow = head 
        fast = head 
        while fast and fast.next:
            slow = slow.next 
            fast = fast.next.next 
        curr = slow
        nn = None 
        prev = None 
        while curr:
            nn = curr.next
            curr.next = prev 
            prev = curr 
            curr = nn 
        first = head 
        sec = prev
        while sec:
            if first.val == sec.val:
                first = first.next
                sec= sec.next
            else:
                return False 
        return True  

        
