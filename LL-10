# Definition for singly-linked list.
# class ListNode(object):
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution(object):
    def deleteDuplicates(self, head):
        if head is None:
            return None
        slow = head 
        fast = slow.next
        while slow and slow.next: 
            nn = fast.next
            if slow.val == fast.val:
                fast = nn
                slow.next = fast    
            else:
                slow = slow.next
                fast = fast.next
        return head
        
