# here at one point slow and fast will point to the same node . if yes true and cycle exist
class Solution(object):
    def hasCycle(self, head):
        slow = head 
        fast = head 
        while fast and fast.next:
            slow = slow.next
            fast = fast.next.next
            if slow == fast:
                return True 
        return False
